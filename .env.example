# SharePoint field library. Leave values blank in this file.
# Real values belong in .env or the process environment, never in git.
SP_TENANT_ID=
SP_CLIENT_ID=
SP_CLIENT_SECRET=
SP_HOST=
SP_SITE=
SP_FOLDER=
SP_FILE=
SP_SHEET=
SP_CACHE_SECONDS=300

# ATLAS AI (Studioshare AI Gateway). Leave values blank in this file.
# Launch injects STUDIOSHARE_AI_GATEWAY_URL and STUDIOSHARE_OIDC_URL.
# ATLAS_AI_ENABLED must be the literal "true" to turn AI on.
ATLAS_AI_ENABLED=
ATLAS_AI_FEATURES=
STUDIOSHARE_AI_GATEWAY_URL=
STUDIOSHARE_OIDC_URL=
# Local development only: a pre-minted app token, or a personal access token
# (the access token is refused unless ATLAS_APP_ENV=local).
STUDIOSHARE_OIDC_TOKEN=
STUDIOSHARE_AI_API_KEY=
STUDIOSHARE_AI_MODELS=
STUDIOSHARE_AI_CODE_MODELS=
ATLAS_AI_TIMEOUT_MS=
ATLAS_AI_USER_PER_MINUTE=
ATLAS_AI_USER_PER_DAY=
