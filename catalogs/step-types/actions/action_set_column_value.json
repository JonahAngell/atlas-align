{
  "schemaVersion": 2,
  "kind": "action",
  "id": "action_set_column_value",
  "version": 1,
  "name": "set_column_value",
  "label": "Set value from a field",
  "order": 40,
  "description": "Copy a field into a column.",
  "status": "active",
  "fields": [],
  "partials": {
    "english": "{{phrase \"analyst_logic.if_then.then_set_column_value\" target_column=(quote param.then_target_column) value_column=(tableColumn (default param.then_value_source_file param.source_file) (default param.then_value_source_alias param.source_alias) param.then_value_field)}}",
    "elseEnglish": "{{phrase \"analyst_logic.else.set_column_value\" target_column=(quote param.then_target_column) value_column=(tableColumn (default param.then_value_source_file param.source_file) (default param.then_value_source_alias param.source_alias) param.then_value_field)}}",
    "shape": "value",
    "formula": "{{> valueFormula}}",
    "elseFormula": "{{> valueFormula}}",
    "formulaNote": "{{#if (and (eq elseStep.param.then_action_type \"display_text\") (eq (action \"actionTarget\" elseStep) (include \"actionTarget\")))}}{{phrase \"developer_logic.notes.append_message_excel\" column=(concat \"\\\"\" (include \"actionTarget\") \"\\\"\")}}{{/if}}",
    "actionTarget": "{{default param.then_target_column (placeholder \"target_column\" \"[target column]\")}}",
    "actionValue": {
      "default": "{{field (default param.then_value_source_file param.source_file) param.then_value_field alias=param.then_value_source_alias}}"
    },
    "actionExpression": {
      "excel": "{{> actionValue}}",
      "sql": "{{> actionValue}}"
    },
    "unmatched": {
      "excel": "\"\"",
      "sql": ""
    },
    "matchedLines": {
      "python": "df.loc[mask, {{quote (include \"actionTarget\")}}] = {{> actionValue}}"
    },
    "unmatchedLines": {
      "python": "df.loc[~mask, {{quote (include \"actionTarget\")}}] = {{> actionValue}}"
    }
  },
  "export": {
    "qtest": {
      "action": {
        "kind": "set_column",
        "targetColumn": "{{param.then_target_column}}",
        "valueField": "{{param.then_value_field}}",
        "calculated": "false"
      }
    },
    "fileUtility": {
      "action": "set_column_value"
    }
  }
}
