{
  "schemaVersion": 2,
  "kind": "action",
  "id": "action_set_column_string_transform",
  "version": 1,
  "name": "set_column_string_transform",
  "label": "String transformation",
  "order": 30,
  "description": "Write part of a text value into a column.",
  "status": "active",
  "picker": {
    "label": "Set Column to String Transformation",
    "description": "Take characters or a character count from a field."
  },
  "editor": {
    "className": "string-transform-builder",
    "heading": "Action"
  },
  "fields": [
    {
      "param": "then_string_operation",
      "control": "block",
      "block": "action_set_column_string_transform",
      "label": "Operation",
      "normalize": "then_string_transform"
    }
  ],
  "complete": [
    "then_target_column",
    "then_string_source_field",
    "then_string_operation"
  ],
  "partials": {
    "english": "{{stringTransformPhrase param prefix=\"then_\" context=\"if_then\"}}",
    "elseEnglish": "{{phrase \"analyst_logic.else.string_transform\" phrase=(stringTransformPhrase param prefix=\"then_\" context=\"if_then\")}}",
    "shape": "value",
    "formula": "{{> valueFormula}}",
    "elseFormula": "{{> valueFormula}}",
    "formulaNote": "{{#if (and (eq elseStep.param.then_action_type \"display_text\") (eq (action \"actionTarget\" elseStep) (include \"actionTarget\")))}}{{phrase \"developer_logic.notes.append_message_excel\" column=(concat \"\\\"\" (include \"actionTarget\") \"\\\"\")}}{{/if}}",
    "actionTarget": "{{default (stringTransformTarget param prefix=\"then_\") (placeholder \"destination_column\" \"[destination column]\")}}",
    "actionValue": {
      "default": "{{stringTransformFormula param prefix=\"then_\"}}"
    },
    "actionExpression": {
      "excel": "{{> actionValue}}",
      "sql": "{{> actionValue}}"
    },
    "unmatched": {
      "excel": "\"\"",
      "sql": ""
    },
    "matchedLines": {
      "python": "df.loc[mask, {{quote (include \"actionTarget\")}}] = {{> actionValue}}"
    },
    "unmatchedLines": {
      "python": "df.loc[~mask, {{quote (include \"actionTarget\")}}] = {{> actionValue}}"
    }
  },
  "export": {
    "qtest": {
      "action": {
        "kind": "set_column",
        "targetColumn": "{{param.then_target_column}}",
        "valueField": "{{param.then_value_field}}",
        "calculated": "true"
      }
    },
    "fileUtility": {
      "action": "set_column_string_transform"
    }
  }
}
