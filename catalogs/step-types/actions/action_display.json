{
  "schemaVersion": 2,
  "kind": "action",
  "id": "action_display",
  "version": 1,
  "name": "display",
  "label": "Display",
  "order": 60,
  "description": "Display the records.",
  "status": "active",
  "picker": {
    "label": "Display / Do Not Display",
    "description": "Keep or remove the records that match."
  },
  "fields": [
    {
      "param": "then_exclude_scope",
      "control": "block",
      "block": "action_display",
      "label": "Matching records"
    }
  ],
  "partials": {
    "english": "{{phrase \"analyst_logic.if_then.then_display\"}}",
    "elseEnglish": "{{phrase \"analyst_logic.else.display\"}}",
    "shape": "filter",
    "formula": "{{> filter}}",
    "elseFormula": "{{> filter}}",
    "formulaNote": "{{phrase \"developer_logic.display_notes.display\"}}",
    "elseFormulaNote": "{{phrase \"developer_logic.display_notes.else_display\"}}"
  },
  "export": {
    "qtest": {
      "action": {
        "kind": "{{#if (or (blank (trim (default param.then_action step.action))) (branchLead (trim (default param.then_action step.action))))}}none{{else}}{{freeformOutcome (trim (default param.then_action step.action)) part=\"kind\"}}{{/if}}",
        "message": "{{freeformOutcome (trim (default param.then_action step.action)) part=\"message\"}}",
        "outputColumn": "{{freeformOutcome (trim (default param.then_action step.action)) part=\"outputColumn\"}}",
        "targetColumn": "{{param.then_target_column}}",
        "valueField": "{{param.then_value_field}}",
        "calculated": "true",
        "text": "{{freeformOutcome (trim (default param.then_action step.action)) part=\"text\"}}"
      }
    },
    "fileUtility": {
      "action": "display"
    }
  }
}
