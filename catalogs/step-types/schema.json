{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas-align/step-type-definition",
  "title": "ATLAS Align step type definition",
  "description": "One step type: its backend name, editor fields, English, automatic notes, Excel/SQL/Python formulas, export roles, validation and tests. Read by js/step-types/01-schema.js, which supports only the keywords used here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "label",
    "status",
    "fields",
    "english",
    "formulas",
    "export"
  ],
  "properties": {
    "$comment": { "type": "string" },
    "schemaVersion": { "enum": [1, 2] },
    "id": { "$ref": "#/$defs/identifier" },
    "version": { "type": "integer", "minimum": 1 },
    "label": { "$ref": "#/$defs/label" },
    "description": { "type": "string", "maxLength": 500 },
    "category": { "$ref": "#/$defs/identifier" },
    "order": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "status": { "enum": ["active", "legacy"] },
    "legacyType": { "$ref": "#/$defs/identifier" },
    "aliases": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step_type": { "$ref": "#/$defs/identifierList" },
        "type": { "$ref": "#/$defs/identifierList" }
      }
    },
    "migrations": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/migration" }
    },
    "subtypes": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/subtypes" }],
      "description": "null or a subtype list"
    },
    "fields": { "$ref": "#/$defs/fieldList" },
    "editorFrame": {
      "type": "object",
      "additionalProperties": false,
      "description": "Internal, never offered by the builder: the frame of an editor that came with ATLAS Align and did not use the standard one. Kept for Join, whose form has its own class and a heading that follows the join type, and for IF / THEN and ELSE, whose forms have no heading and, for IF / THEN, two tabs.",
      "properties": {
        "standalone": {
          "const": true,
          "description": "Leaves out the outer selected-source-only-builder frame."
        },
        "className": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,59}$",
          "description": "An extra class on the guided-builder frame."
        },
        "heading": {
          "oneOf": [{ "$ref": "#/$defs/template" }, { "const": false }],
          "description": "The heading, as a plain template, in place of the label. false leaves the heading out."
        },
        "tabs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "description": "Tabs that each show the fields whose `tab` names them; the first opens until one is chosen. Fields without a tab come before the tabs.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/identifier" },
              "label": { "$ref": "#/$defs/label" }
            }
          }
        }
      }
    },
    "block": {
      "$ref": "#/$defs/identifier",
      "description": "A behavior block from js/13-step-type-library.js. It supplies the editor, English, notes, formulas, created columns and normalization it has; the definition supplies the rest."
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assigns": { "$ref": "#/$defs/template" },
        "creates": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/template" }
        }
      }
    },
    "english": { "$ref": "#/$defs/templateSet" },
    "formulas": { "$ref": "#/$defs/formulas" },
    "autoNotes": {
      "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/templateSet" }],
      "description": "null or a template set"
    },
    "export": { "$ref": "#/$defs/export" },
    "partials": {
      "$comment": "Templates included with {{> name}}. Only with schemaVersion 2 (checked by js/step-types/02-definitions.js).",
      "type": "object",
      "maxProperties": 200,
      "propertyNames": {
        "type": "string",
        "maxLength": 64,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": { "$ref": "#/$defs/partial" }
    },
    "validation": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/validationRule" }
    },
    "textImport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fromEnglish": { "type": "boolean" },
        "handler": { "$ref": "#/$defs/identifier" }
      }
    },
    "tests": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/testCase" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "identifierList": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "paramName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "stepField": {
      "enum": ["source", "field", "title", "notes", "type", "step_type"]
    },
    "label": { "type": "string", "minLength": 1, "maxLength": 120 },
    "template": { "type": "string", "maxLength": 20000 },
    "partial": {
      "oneOf": [
        { "$ref": "#/$defs/template" },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "english": { "$ref": "#/$defs/template" },
            "plain": { "$ref": "#/$defs/template" },
            "excel": { "$ref": "#/$defs/template" },
            "sql": { "$ref": "#/$defs/template" },
            "python": { "$ref": "#/$defs/template" },
            "default": { "$ref": "#/$defs/template" }
          }
        }
      ]
    },
    "scalar": { "type": ["string", "number", "boolean", "null"] },
    "templateSet": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "default": { "$ref": "#/$defs/template" },
        "bySubtype": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/template" }
        },
        "variants": {
          "description": "Templates chosen by a condition on the step's parameters. The first variant whose `when` holds wins over bySubtype and default.",
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when", "template"],
            "properties": {
              "when": { "$ref": "#/$defs/condition" },
              "template": { "$ref": "#/$defs/template" }
            }
          }
        }
      }
    },
    "formulaTriple": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "excel": { "$ref": "#/$defs/template" },
        "sql": { "$ref": "#/$defs/template" },
        "python": { "$ref": "#/$defs/template" }
      }
    },
    "formulas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape"],
      "properties": {
        "shape": {
          "enum": ["expression", "assignment", "filter", "frame", "none"]
        },
        "target": { "$ref": "#/$defs/template" },
        "lead": { "$ref": "#/$defs/template" },
        "default": { "$ref": "#/$defs/formulaTriple" },
        "bySubtype": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/formulaTriple" }
        },
        "notes": {
          "description": "Developer Logic notes, one template each. A note that renders blank is left out.",
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/template" }
        },
        "variants": {
          "description": "Formulas chosen by a condition on the step's parameters. The first variant whose `when` holds replaces the shape, target, formulas and notes it sets.",
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when"],
            "properties": {
              "when": { "$ref": "#/$defs/condition" },
              "shape": {
                "enum": ["expression", "assignment", "filter", "frame", "none"]
              },
              "target": { "$ref": "#/$defs/template" },
              "excel": { "$ref": "#/$defs/template" },
              "sql": { "$ref": "#/$defs/template" },
              "python": { "$ref": "#/$defs/template" },
              "notes": {
                "type": "array",
                "maxItems": 20,
                "items": { "$ref": "#/$defs/template" }
              }
            }
          }
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "notes": {
              "type": "array",
              "maxItems": 20,
              "items": { "type": "string", "minLength": 1, "maxLength": 200 }
            }
          }
        }
      }
    },
    "condition": {
      "description": "a condition: {param|stepField, equals|equalsIgnoreCase|notEquals|in|blank|notBlank|positiveWholeNumber} or {all|any: [...]} or {not: condition}",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "param": { "$ref": "#/$defs/paramName" },
        "stepField": { "$ref": "#/$defs/stepField" },
        "equals": { "$ref": "#/$defs/scalar" },
        "equalsIgnoreCase": {
          "$ref": "#/$defs/scalar",
          "description": "Holds when the value equals this one, ignoring upper and lower case."
        },
        "notEquals": { "$ref": "#/$defs/scalar" },
        "in": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/scalar" }
        },
        "blank": { "const": true },
        "notBlank": { "const": true },
        "positiveWholeNumber": {
          "const": true,
          "description": "Holds when the value is a whole number greater than 0, such as 3 or 012."
        },
        "all": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/condition" }
        },
        "any": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/condition" }
        },
        "not": { "$ref": "#/$defs/condition" }
      }
    },
    "choiceOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": "string", "maxLength": 200 },
        "label": { "$ref": "#/$defs/label" },
        "description": { "type": "string", "maxLength": 500 },
        "hidden": {
          "type": "boolean",
          "description": "Hidden for new steps. A step that already uses the option still shows it."
        },
        "visibleWhen": { "$ref": "#/$defs/condition" },
        "fields": { "$ref": "#/$defs/fieldList" },
        "export": { "$ref": "#/$defs/exportOverride" }
      }
    },
    "subtypes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["param", "options"],
      "properties": {
        "param": { "$ref": "#/$defs/paramName" },
        "label": { "$ref": "#/$defs/label" },
        "control": { "enum": ["cards", "chips", "segment", "list"] },
        "default": { "type": "string", "maxLength": 200 },
        "hidden": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 200 }
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "$ref": "#/$defs/choiceOption" }
        }
      }
    },
    "fieldList": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/field" }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["param", "control"],
      "properties": {
        "param": { "$ref": "#/$defs/paramName" },
        "control": {
          "enum": [
            "source_picker",
            "field_picker",
            "choice",
            "text",
            "textarea",
            "whole_number",
            "toggle",
            "hidden",
            "hint",
            "callout",
            "readout",
            "block",
            "sort_keys",
            "duplicate_keys",
            "condition_group",
            "action",
            "math",
            "string_transform",
            "join_type",
            "join_keys"
          ],
          "description": "A control from catalogs/step-types/controls.json."
        },
        "label": { "$ref": "#/$defs/label" },
        "placeholder": { "type": "string", "maxLength": 200 },
        "help": { "type": "string", "maxLength": 1000 },
        "helpId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$",
          "description": "Id of the help text. Defaults to atlas-<param>-hint."
        },
        "required": { "type": "boolean" },
        "requiredIssue": {
          "type": "boolean",
          "description": "false keeps the required mark but leaves the Audit Issue to the type's own checks."
        },
        "default": { "$ref": "#/$defs/scalar" },
        "valueTemplate": {
          "description": "The value the editor shows while the parameter is blank.",
          "$ref": "#/$defs/template"
        },
        "visibleWhen": { "$ref": "#/$defs/condition" },
        "enabledWhen": { "$ref": "#/$defs/condition" },
        "sourceParam": { "$ref": "#/$defs/paramName" },
        "clearable": {
          "type": "boolean",
          "description": "A field picker's Clear button, which empties the field and its sourceParam."
        },
        "clearKey": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,40}$",
          "description": "Internal: writes the legacy data-clear-concat-field button instead."
        },
        "legacyOptionSpacing": {
          "type": "boolean",
          "description": "Internal: a select writes <option value=\"x\" > as the legacy editors did."
        },
        "pairClass": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,59}$",
          "description": "Internal: an extra class on the row a pair field starts."
        },
        "className": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,59}$",
          "description": "Internal: an extra class on a hint."
        },
        "group": { "$ref": "#/$defs/identifier" },
        "tab": {
          "$ref": "#/$defs/identifier",
          "description": "Internal: the editorFrame tab that shows this field."
        },
        "branch": {
          "enum": ["THEN", "ELSE"],
          "description": "The branch an action field writes: THEN (the default) or ELSE."
        },
        "sharesParam": {
          "type": "boolean",
          "description": "Internal: lets this field show a param another field also shows, in another mode."
        },
        "layout": {
          "enum": ["full", "pair"],
          "description": "full spans the editor row; pair puts shown fields next to each other in one row."
        },
        "display": { "enum": ["cards", "chips", "segment", "list", "select"] },
        "heading": { "$ref": "#/$defs/label" },
        "popover": { "enum": ["list", "pills", "grid"] },
        "options": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/choiceOption" }
        },
        "optionsFrom": { "type": "string", "maxLength": 200 },
        "block": { "$ref": "#/$defs/identifier" },
        "blockOptions": { "type": "object" },
        "min": { "type": "integer" },
        "max": { "type": "integer" },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "suggestions": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "maxLength": 200 }
        },
        "message": {
          "description": "A callout's text, as an English template.",
          "$ref": "#/$defs/template"
        },
        "features": {
          "description": "Switches a control's features on or off (catalogs/step-types/controls.json). Only features the palette marks switchable can be named. Off hides the feature for new steps only; a saved step that uses it still shows it.",
          "type": "object",
          "additionalProperties": { "type": "boolean" }
        }
      }
    },
    "scriptRole": {
      "enum": [
        "source",
        "join",
        "union",
        "column",
        "filter",
        "sort",
        "dedupe",
        "condition",
        "else",
        "flag",
        "none"
      ]
    },
    "qtest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "section": { "type": "string", "minLength": 1, "maxLength": 20 },
        "testType": { "type": "string", "minLength": 1, "maxLength": 120 },
        "outcomes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["atlas", "source"],
          "description": "The two expected outcomes on the qTest row, as English templates. A behavior block's qtestOutcomes takes their place.",
          "properties": {
            "atlas": { "$ref": "#/$defs/template" },
            "source": { "$ref": "#/$defs/template" }
          }
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "description": "The outcome qTest tests, as plain templates. kind renders display_text (with message and outputColumn), do_not_display, set_column (with targetColumn, valueField and calculated, true or false), freeform (with text) or none. Without it, a type with an action field reads the outcome from the app's action code.",
          "properties": {
            "kind": { "$ref": "#/$defs/template" },
            "message": { "$ref": "#/$defs/template" },
            "outputColumn": { "$ref": "#/$defs/template" },
            "targetColumn": { "$ref": "#/$defs/template" },
            "valueField": { "$ref": "#/$defs/template" },
            "calculated": { "$ref": "#/$defs/template" },
            "text": { "$ref": "#/$defs/template" }
          }
        }
      }
    },
    "exportOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scriptRole": { "$ref": "#/$defs/scriptRole" },
        "qtest": { "$ref": "#/$defs/qtest" }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scriptRole"],
      "properties": {
        "scriptRole": { "$ref": "#/$defs/scriptRole" },
        "qtest": { "$ref": "#/$defs/qtest" },
        "fileUtility": { "$ref": "#/$defs/fileUtility" },
        "rules": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when"],
            "properties": {
              "when": { "$ref": "#/$defs/condition" },
              "scriptRole": { "$ref": "#/$defs/scriptRole" },
              "qtest": { "$ref": "#/$defs/qtest" }
            }
          }
        }
      }
    },
    "fileUtility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiler"],
      "description": "How File Utility runs this step type. compiler names one of the compilers in catalogs/file-utility/executable-steps.json. A step type without this block can't run in File Utility.",
      "properties": {
        "compiler": { "$ref": "#/$defs/identifier" },
        "status": {
          "enum": ["supported", "partial"],
          "description": "supported (the default) runs as is; partial runs only in the cases named in when."
        },
        "when": {
          "type": "string",
          "maxLength": 500,
          "description": "The cases a partial step type runs in, or a limit on a supported one, shown in the readiness report."
        },
        "params": {
          "type": "object",
          "maxProperties": 50,
          "description": "The compiler's params mapped to this step type's params, for a type whose fields are named differently. Params left out keep their own names.",
          "propertyNames": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "validationRule": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["severity", "message"] },
        { "required": ["builtIn"] }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "builtIn": {
          "enum": [
            "conditions",
            "fieldRelationships",
            "action",
            "join",
            "createdColumns",
            "sourceMath",
            "thenMath",
            "stringTransform",
            "thenStringTransform"
          ],
          "description": "Turns on one of the Audit Issues checks for this step type: condition rows, field-to-field comparisons that need a JOIN, a THEN action, join keys, Create Column params, calculations in source_math_json or then_math_json, and string transformations in the string_* or then_string_* params. The rule catalog (catalogs/audit-issue-rules.json) gives its severity and message; `when` limits it to some steps."
        },
        "when": {
          "anyOf": [{ "const": "always" }, { "$ref": "#/$defs/condition" }],
          "description": "\"always\" or a condition"
        },
        "require": { "$ref": "#/$defs/paramName" },
        "check": { "$ref": "#/$defs/condition" },
        "severity": { "enum": ["warning", "critical"] },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "valueSource": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "pattern": "^(param|step)\\.[A-Za-z][A-Za-z0-9_]*$"
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": {
          "enum": [
            "setStepType",
            "default",
            "set",
            "rename",
            "remove",
            "mapValue",
            "handler"
          ]
        },
        "when": { "$ref": "#/$defs/condition" },
        "to": { "type": "string", "minLength": 1, "maxLength": 80 },
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "param": { "$ref": "#/$defs/paramName" },
        "value": {},
        "valueFrom": { "$ref": "#/$defs/valueSource" },
        "template": { "$ref": "#/$defs/template" },
        "map": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/scalar" }
        },
        "name": { "$ref": "#/$defs/identifier" }
      }
    },
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "params", "expect"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "params": { "type": "object" },
        "step": { "type": "object" },
        "parent": { "type": "object" },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "english": { "type": "string" },
            "autoNotes": { "type": "string" },
            "excel": { "type": "string" },
            "sql": { "type": "string" },
            "python": { "type": "string" },
            "issues": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
