{
  "schemaVersion": 1,
  "id": "flag_records",
  "version": 2,
  "label": "Flag Records",
  "category": "logic",
  "description": "Flag matching records or hide them.",
  "status": "legacy",
  "legacyType": "if",
  "aliases": {
    "step_type": [],
    "type": []
  },
  "migrations": [
    {
      "op": "handler",
      "name": "copy_step_source"
    }
  ],
  "fields": [
    {
      "param": "source_file",
      "control": "hidden"
    },
    {
      "param": "source_alias",
      "control": "hidden",
      "valueTemplate": "{{sourceAliasFor param.source_file}}"
    },
    {
      "param": "field_name",
      "control": "field_picker",
      "label": "Field",
      "placeholder": "Select field",
      "sourceParam": "source_file"
    },
    {
      "param": "operator",
      "control": "choice",
      "label": "Operator",
      "heading": "Operator",
      "display": "chips",
      "popover": "pills",
      "optionsFrom": "app_config.logic_options.operators",
      "options": [
        {
          "value": "is equal to",
          "label": "is equal to"
        }
      ]
    },
    {
      "param": "compare_value",
      "control": "textarea",
      "label": "Compare Value",
      "placeholder": "One or more values"
    },
    {
      "param": "flag_action",
      "control": "choice",
      "label": "Flag action",
      "heading": "Flag Action",
      "display": "cards",
      "popover": "list",
      "options": [
        {
          "value": "display_text",
          "label": "Display text response",
          "description": "Show a message for the matching record."
        },
        {
          "value": "do_not_display",
          "label": "Do not display record",
          "description": "Hide the matching record."
        }
      ]
    },
    {
      "param": "message",
      "control": "text",
      "label": "Message",
      "visibleWhen": {
        "not": { "param": "flag_action", "equals": "do_not_display" }
      }
    },
    {
      "param": "output_column",
      "control": "field_picker",
      "label": "Output Column",
      "placeholder": "Select field",
      "valueTemplate": "{{placeholder \"error_message_column\" \"Error Message\"}}",
      "visibleWhen": {
        "not": { "param": "flag_action", "equals": "do_not_display" }
      }
    }
  ],
  "english": {
    "default": "{{phrase \"analyst_logic.flag_records.condition\" table_column=(tableColumn param.source_file param.source_alias param.field_name) operator=(orEmpty param.operator \"is equal to\") compare_value=(valueList param.compare_value lead=\" \")}} {{#if (eq param.flag_action \"do_not_display\")}}{{phrase \"analyst_logic.flag_records.do_not_display\"}}{{else}}{{phrase \"analyst_logic.flag_records.display_text\" message=(quote param.message) output_column=(quote (orEmpty param.output_column (placeholder \"error_message_column\" \"Error Message\")))}}{{/if}}"
  },
  "formulas": {
    "shape": "frame",
    "default": {
      "excel": "{{conditionFormula param step}}",
      "sql": "{{conditionFormula param step}}",
      "python": "{{conditionFormula param step}}"
    },
    "notes": ["{{conditionFormula param step note=0}}"]
  },
  "autoNotes": null,
  "export": {
    "scriptRole": "flag",
    "qtest": {
      "action": {
        "kind": "display_text",
        "message": "{{param.message}}",
        "outputColumn": "{{orEmpty param.output_column (placeholder \"error_message_column\" \"Error Message\")}}"
      }
    },
    "rules": [
      {
        "when": {
          "param": "flag_action",
          "equals": "do_not_display"
        },
        "qtest": {
          "action": {
            "kind": "do_not_display"
          }
        }
      }
    ]
  },
  "textImport": {
    "fromEnglish": false
  },
  "validation": [
    {
      "builtIn": "conditions"
    },
    {
      "builtIn": "action"
    }
  ]
}
