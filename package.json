{
  "name": "atlas-field-library-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone StudioShare PostgreSQL backend for atomic ATLAS Field Library CSV replacement",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:linux": "/usr/bin/node server.js",
    "dev:proxy": "launch dev",
    "dev:local": "bash -c 'set -e; launch dev & proxy_pid=$!; cleanup() { kill $proxy_pid $app_pid 2>/dev/null || true; }; trap cleanup EXIT INT TERM; STUDIOSHARE_API_URL=http://localhost:7070 /usr/bin/node server.js & app_pid=$!; wait -n $proxy_pid $app_pid'",
    "check": "node tools/check-syntax.mjs",
    "version:sync": "node tools/sync-app-version.mjs",
    "version:check": "node tools/sync-app-version.mjs --check",
    "test": "node --test",
    "local:up": "docker compose up --build",
    "local:down": "docker compose down",
    "local:reset": "docker compose down -v",
    "local:logs": "docker compose logs -f app db",
    "review:bundle": "node tools/create-review-bundle.mjs --files review-bundle-files.txt --title \"ATLAS ALIGN FEATURE REVIEW BUNDLE\"",
    "version:bump": "node tools/sync-app-version.mjs --bump",
    "version:hook": "node tools/sync-app-version.mjs --hook",
    "hooks:install": "node tools/install-git-hooks.mjs",
    "css:check": "node build-css.mjs --check"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "multer": "^2.4.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "postcss": "^8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-sql": "^0.20.0"
  },
  "overrides": {
    "ip-address": "10.7.3",
    "uuid": "11.1.1"
  }
}
