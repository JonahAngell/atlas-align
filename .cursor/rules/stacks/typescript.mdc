## Type Guards

```typescript
// typeof guard
function process(value: string | number) {
  if (typeof value === "string") {
    return value.toUpperCase();
  }
  return value * 2;
}

// Custom type guard
function isDog(pet: Dog | Cat): pet is Dog {
  return 'bark' in pet;
}

// in operator
function move(animal: Fish | Bird) {
  if ("swim" in animal) {
    animal.swim();
  }
}
```

